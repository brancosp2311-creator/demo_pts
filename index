<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PermitPro — Demo Nestlé</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
  :root {
    --blue-dark: #1F3864; --blue-mid: #2E75B6; --blue-light: #D5E8F0; --blue-accent: #4472C4;
    --green: #375623; --green-light: #E2EFDA; --green-mid: #70AD47;
    --orange: #C55A11; --orange-light: #FCE4D6;
    --red: #C0392B; --red-light: #FDECEA;
    --yellow: #F39C12; --yellow-light: #FEF9E7;
    --gray-light: #F5F7FA; --gray-med: #E8ECF0; --gray-dark: #6B7280;
    --white: #FFFFFF; --text: #1F2937; --text-light: #6B7280;
    --nestle-red: #C8102E; --nestle-dark: #1A1A1A;
    --sidebar-w: 240px; --header-h: 60px;
    --shadow: 0 2px 8px rgba(0,0,0,0.10); --shadow-lg: 0 8px 24px rgba(0,0,0,0.12);
    --radius: 10px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Segoe UI', Arial, sans-serif; background: var(--gray-light); color: var(--text); font-size: 14px; display: flex; height: 100vh; overflow: hidden; }

  /* SIDEBAR */
  #sidebar { width: var(--sidebar-w); background: var(--blue-dark); display: flex; flex-direction: column; height: 100vh; flex-shrink: 0; z-index: 100; }
  .sidebar-logo { padding: 20px 20px 16px; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .sidebar-logo .logo-text { font-size: 22px; font-weight: 800; color: #fff; letter-spacing: 1px; }
  .sidebar-logo .logo-sub { font-size: 10px; color: rgba(255,255,255,0.5); letter-spacing: 0.5px; margin-top: 2px; }
  .sidebar-nav { flex: 1; padding: 16px 0; overflow-y: auto; }
  .nav-section { font-size: 10px; color: rgba(255,255,255,0.35); text-transform: uppercase; letter-spacing: 1px; padding: 12px 20px 6px; }
  .nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 20px; cursor: pointer; color: rgba(255,255,255,0.7); transition: all 0.15s; border-left: 3px solid transparent; font-size: 13px; }
  .nav-item:hover { background: rgba(255,255,255,0.08); color: #fff; }
  .nav-item.active { background: rgba(255,255,255,0.12); color: #fff; border-left-color: #4FC3F7; }
  .nav-item .nav-icon { font-size: 16px; width: 20px; text-align: center; }
  .nav-badge { margin-left: auto; background: #EF4444; color: #fff; border-radius: 10px; padding: 1px 7px; font-size: 10px; font-weight: 700; }
  .sidebar-user { padding: 16px 20px; border-top: 1px solid rgba(255,255,255,0.1); }
  .user-info { display: flex; align-items: center; gap: 10px; }
  .user-avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--blue-mid); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 13px; flex-shrink: 0; }
  .user-name { color: #fff; font-size: 12px; font-weight: 600; }
  .user-role { color: rgba(255,255,255,0.5); font-size: 10px; }

  /* MAIN */
  #main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
  #topbar { height: var(--header-h); background: var(--white); border-bottom: 1px solid var(--gray-med); display: flex; align-items: center; padding: 0 24px; gap: 16px; flex-shrink: 0; }
  .topbar-title { font-size: 17px; font-weight: 700; color: var(--blue-dark); flex: 1; }
  .search-box { display: flex; align-items: center; gap: 8px; background: var(--gray-light); border: 1px solid var(--gray-med); border-radius: 8px; padding: 6px 12px; width: 280px; }
  .search-box input { border: none; background: none; outline: none; font-size: 13px; color: var(--text); width: 100%; }
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 8px; border: none; cursor: pointer; font-size: 13px; font-weight: 600; transition: all 0.15s; }
  .btn-primary { background: var(--blue-mid); color: #fff; }
  .btn-primary:hover { background: var(--blue-dark); }
  .btn-success { background: var(--green-mid); color: #fff; }
  .btn-danger { background: var(--red); color: #fff; }
  .btn-outline { background: #fff; color: var(--blue-mid); border: 1px solid var(--blue-mid); }
  .btn-nestle { background: var(--nestle-red); color: #fff; }
  .btn-sm { padding: 5px 12px; font-size: 12px; }
  .notif-btn { position: relative; background: none; border: none; cursor: pointer; font-size: 20px; color: var(--gray-dark); padding: 4px; }
  .notif-dot { position: absolute; top: 4px; right: 4px; width: 8px; height: 8px; background: #EF4444; border-radius: 50%; border: 2px solid #fff; }
  #content { flex: 1; overflow-y: auto; padding: 24px; scrollbar-width: thin; }
  #content::-webkit-scrollbar { width: 6px; }
  #content::-webkit-scrollbar-thumb { background: var(--gray-med); border-radius: 3px; }

  .screen { display: none; }
  .screen.active { display: block; }

  /* CARDS */
  .card { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow); padding: 20px; }
  .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
  .kpi-card { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow); padding: 20px; border-top: 4px solid transparent; }
  .kpi-card.green { border-top-color: var(--green-mid); }
  .kpi-card.yellow { border-top-color: var(--yellow); }
  .kpi-card.red { border-top-color: var(--red); }
  .kpi-card.blue { border-top-color: var(--blue-mid); }
  .kpi-icon { font-size: 28px; margin-bottom: 8px; }
  .kpi-num { font-size: 36px; font-weight: 800; color: var(--blue-dark); line-height: 1; }
  .kpi-label { font-size: 12px; color: var(--text-light); margin-top: 4px; font-weight: 500; }
  .kpi-trend { font-size: 11px; margin-top: 8px; }
  .kpi-trend.up { color: var(--green-mid); }
  .kpi-trend.down { color: var(--red); }
  .dash-grid { display: grid; grid-template-columns: 1fr 340px; gap: 20px; }

  /* TABLES */
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  th { background: var(--blue-dark); color: #fff; padding: 10px 14px; font-size: 12px; text-align: left; font-weight: 600; }
  td { padding: 10px 14px; border-bottom: 1px solid var(--gray-med); font-size: 13px; }
  tr:hover td { background: var(--gray-light); }

  /* BADGES */
  .badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; }
  .badge-green { background: var(--green-light); color: var(--green); }
  .badge-blue { background: var(--blue-light); color: var(--blue-dark); }
  .badge-yellow { background: var(--yellow-light); color: #92610C; }
  .badge-red { background: var(--red-light); color: var(--red); }
  .badge-orange { background: var(--orange-light); color: var(--orange); }
  .badge-gray { background: var(--gray-med); color: var(--gray-dark); }
  .type-pill { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; }
  .type-alt { background: #EBF3FB; color: #1565C0; }
  .type-esc { background: #FFF3E0; color: #E65100; }
  .type-hot { background: #FFEBEE; color: #B71C1C; }
  .type-ele { background: #F3E5F5; color: #6A1B9A; }
  .type-exc { background: #FFFDE7; color: #F57F17; }
  .type-ene { background: #E8F5E9; color: #1B5E20; }

  /* ACTIVITY */
  .activity-list { display: flex; flex-direction: column; gap: 0; }
  .activity-item { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--gray-med); }
  .activity-item:last-child { border-bottom: none; }
  .activity-dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 5px; flex-shrink: 0; }
  .activity-dot.green { background: var(--green-mid); }
  .activity-dot.blue { background: var(--blue-mid); }
  .activity-dot.red { background: var(--red); }
  .activity-dot.yellow { background: var(--yellow); }
  .activity-dot.orange { background: var(--orange); }
  .activity-text { font-size: 12px; color: var(--text); line-height: 1.5; }
  .activity-time { font-size: 10px; color: var(--text-light); margin-top: 2px; }

  /* FILTER BAR */
  .filter-bar { display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; align-items: center; }
  .filter-select { border: 1px solid var(--gray-med); border-radius: 8px; padding: 7px 12px; font-size: 13px; color: var(--text); background: #fff; outline: none; }

  /* SECTION HEADER */
  .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .section-title { font-size: 15px; font-weight: 700; color: var(--blue-dark); }
  .chart-wrap { position: relative; height: 220px; }
  .alert-banner { border-radius: 8px; padding: 10px 16px; margin-bottom: 16px; display: flex; align-items: center; gap: 10px; font-size: 13px; }
  .alert-warning { background: var(--orange-light); color: var(--orange); border: 1px solid #F5CBA7; }
  .alert-info { background: var(--blue-light); color: var(--blue-dark); border: 1px solid #AED6F1; }
  .alert-success { background: var(--green-light); color: var(--green); border: 1px solid #ABEBC6; }

  /* MODAL */
  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.2s; }
  .modal-overlay.open { opacity: 1; pointer-events: all; }
  .modal-box { background: #fff; border-radius: 14px; padding: 28px; max-width: 520px; width: 90%; box-shadow: var(--shadow-lg); transform: scale(0.95); transition: transform 0.2s; }
  .modal-overlay.open .modal-box { transform: scale(1); }
  .modal-title { font-size: 18px; font-weight: 700; color: var(--blue-dark); margin-bottom: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 5px; margin-bottom: 12px; }
  label { font-size: 12px; font-weight: 600; color: var(--text-light); }
  input[type=text], input[type=date], input[type=time], input[type=number], select, textarea {
    border: 1px solid var(--gray-med); border-radius: 8px; padding: 9px 12px; font-size: 13px; color: var(--text); outline: none; transition: border-color 0.15s; background: #fff; font-family: inherit; width: 100%;
  }
  input:focus, select:focus, textarea:focus { border-color: var(--blue-mid); box-shadow: 0 0 0 3px rgba(46,117,182,0.1); }
  textarea { resize: vertical; min-height: 70px; }
  .required-mark { color: var(--red); }

  /* ===== NESTLÉ PERMIT FORM ===== */
  .nestle-form { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; max-width: 960px; margin: 0 auto; }

  /* Nestlé Header */
  .nestle-header { background: var(--white); border-bottom: 3px solid var(--nestle-red); padding: 16px 24px; display: flex; align-items: flex-start; gap: 20px; }
  .nestle-logo-area { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; min-width: 100px; }
  .nestle-brand { font-size: 22px; font-weight: 900; color: var(--nestle-red); letter-spacing: -0.5px; }
  .nestle-she { font-size: 11px; font-weight: 700; color: #333; letter-spacing: 2px; }
  .nestle-title-area { flex: 1; }
  .nestle-title { font-size: 20px; font-weight: 700; color: var(--nestle-dark); }
  .nestle-subtitle { font-size: 11px; color: #555; margin-top: 4px; line-height: 1.4; }
  .nestle-meta { display: flex; flex-direction: column; gap: 6px; min-width: 200px; }
  .nestle-meta-row { display: flex; align-items: center; gap: 8px; }
  .nestle-meta-label { font-size: 11px; font-weight: 600; color: #555; white-space: nowrap; }
  .nestle-meta-input { border: none; border-bottom: 1.5px solid #999; padding: 2px 6px; font-size: 12px; outline: none; flex: 1; min-width: 80px; background: transparent; }

  /* Form sections */
  .nf-section { padding: 0 24px 16px; border-bottom: 1px solid var(--gray-med); }
  .nf-section:last-child { border-bottom: none; }
  .nf-section-header { background: var(--blue-dark); color: #fff; font-weight: 700; font-size: 12px; letter-spacing: 0.5px; padding: 6px 24px; margin: 0 -24px 14px; }
  .nf-section-header.red { background: var(--nestle-red); }
  .nf-section-header.green { background: var(--green); }
  .nf-section-header.orange { background: var(--orange); }
  .nf-field-row { display: flex; gap: 16px; margin-bottom: 10px; flex-wrap: wrap; }
  .nf-field { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 200px; }
  .nf-field label { font-size: 11px; font-weight: 600; color: #555; }
  .nf-field input, .nf-field select, .nf-field textarea { border: none; border-bottom: 1.5px solid #ccc; border-radius: 0; padding: 4px 2px; font-size: 13px; background: transparent; }
  .nf-field input:focus, .nf-field select:focus, .nf-field textarea:focus { border-color: var(--blue-mid); box-shadow: none; }
  .nf-field textarea { min-height: 50px; border: 1.5px solid #ccc; border-radius: 4px; padding: 6px; background: var(--gray-light); }

  /* Pre-permit checks table */
  .check-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .check-table th { background: #f0f4f8; color: var(--text); padding: 6px 10px; font-size: 11px; border: 1px solid #ccc; text-align: center; }
  .check-table td { padding: 5px 10px; border: 1px solid #ddd; vertical-align: top; }
  .check-table .cat-cell { font-weight: 700; color: var(--blue-dark); background: #f8faff; font-size: 11px; text-align: center; vertical-align: middle; }
  .check-table .desc-cell { font-size: 11px; line-height: 1.5; color: var(--text); }
  .check-table .radio-cell { text-align: center; vertical-align: middle; }
  .yn-group { display: flex; gap: 8px; justify-content: center; }
  .yn-btn { width: 32px; height: 26px; border-radius: 4px; border: 1.5px solid #ccc; background: #fff; cursor: pointer; font-size: 11px; font-weight: 700; transition: all 0.12s; color: #666; }
  .yn-btn.active-si { background: var(--green-light); border-color: var(--green-mid); color: var(--green); }
  .yn-btn.active-no { background: var(--red-light); border-color: var(--red); color: var(--red); }
  .yn-btn.active-na { background: #f0f0f0; border-color: #999; color: #555; }

  /* Blood pressure table */
  .bp-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .bp-table th { background: var(--blue-dark); color: #fff; padding: 7px 10px; border: 1px solid #ccc; font-size: 11px; text-align: center; }
  .bp-table td { padding: 4px 6px; border: 1px solid #ddd; }
  .bp-table td input { border: none; border-bottom: 1px solid #ccc; width: 100%; padding: 2px 4px; font-size: 12px; background: transparent; outline: none; }
  .bp-apto { display: flex; gap: 10px; justify-content: center; }
  .bp-radio { display: flex; align-items: center; gap: 3px; font-size: 11px; cursor: pointer; }
  .bp-radio input { width: auto; }

  /* Checklist precautions */
  .prec-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .prec-table th { background: #f0f4f8; color: var(--text); padding: 6px 10px; font-size: 11px; border: 1px solid #ccc; text-align: center; }
  .prec-table td { padding: 5px 10px; border: 1px solid #ddd; vertical-align: top; }
  .prec-table .cat-cell { font-weight: 700; color: var(--blue-dark); background: #f8faff; font-size: 11px; text-align: center; vertical-align: middle; }

  /* Signatures */
  .sig-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .sig-box { border: 1.5px solid #ccc; border-radius: 6px; padding: 12px; }
  .sig-box-title { font-weight: 700; color: var(--blue-dark); font-size: 12px; margin-bottom: 6px; }
  .sig-box-desc { font-size: 10px; color: #666; line-height: 1.4; margin-bottom: 10px; font-style: italic; }
  .sig-field-row { display: flex; gap: 12px; margin-top: 8px; }
  .sig-field { flex: 1; }
  .sig-field label { font-size: 10px; font-weight: 600; color: #555; display: block; margin-bottom: 2px; }
  .sig-field input { border: none; border-bottom: 1.5px solid #999; width: 100%; font-size: 12px; padding: 3px 0; background: transparent; outline: none; }

  /* Part 2 separator */
  .part2-header { background: var(--blue-dark); color: #fff; text-align: center; font-size: 14px; font-weight: 700; padding: 10px; margin: 0 -24px; letter-spacing: 1px; }

  /* Inspection visits table */
  .insp-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .insp-table th { background: var(--blue-dark); color: #fff; padding: 7px 10px; border: 1px solid #ccc; font-size: 11px; }
  .insp-table td { padding: 6px 10px; border: 1px solid #ddd; height: 34px; }
  .insp-table td input { border: none; width: 100%; font-size: 12px; background: transparent; outline: none; }

  /* Progress/stepper */
  .permit-stepper { display: flex; align-items: center; gap: 0; background: var(--white); border-radius: 8px; box-shadow: var(--shadow); padding: 12px 20px; margin-bottom: 20px; overflow-x: auto; }
  .pstep { display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 90px; }
  .pstep-circle { width: 30px; height: 30px; border-radius: 50%; border: 2px solid var(--gray-med); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: var(--gray-dark); background: #fff; }
  .pstep.done .pstep-circle { background: var(--green-mid); border-color: var(--green-mid); color: #fff; }
  .pstep.active .pstep-circle { background: var(--blue-mid); border-color: var(--blue-mid); color: #fff; }
  .pstep-label { font-size: 9px; color: var(--text-light); text-align: center; font-weight: 500; }
  .pstep.active .pstep-label { color: var(--blue-mid); font-weight: 700; }
  .pstep.done .pstep-label { color: var(--green-mid); }
  .pstep-line { flex: 1; height: 2px; background: var(--gray-med); min-width: 20px; }
  .pstep-line.done { background: var(--green-mid); }

  /* Print/PDF preview banner */
  .pdf-banner { background: var(--blue-dark); color: #fff; border-radius: 8px; padding: 10px 16px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .pdf-banner-text { font-size: 12px; }
  .pdf-banner strong { font-size: 14px; display: block; }

  /* Nestle code ref */
  .nestle-ref { font-size: 10px; color: #999; text-align: right; padding: 4px 24px; }

  /* Valid-until banner */
  .valid-until { background: #FFF3CD; border: 1.5px solid #FBBF24; border-radius: 6px; padding: 7px 14px; margin-bottom: 14px; font-size: 12px; color: #92610C; display: flex; align-items: center; gap: 8px; }
</style>
</head>
<body>

<!-- SIDEBAR -->
<div id="sidebar">
  <div class="sidebar-logo">
    <div class="logo-text">🛡 PermitPro</div>
    <div class="logo-sub">NESTLÉ · PREVENCIÓN DE RIESGOS</div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section">Principal</div>
    <div class="nav-item active" onclick="navigate('dashboard')"><span class="nav-icon">📊</span> Dashboard</div>
    <div class="nav-item" onclick="navigate('permisos')"><span class="nav-icon">📋</span> Permisos de Trabajo <span class="nav-badge">3</span></div>
    <div class="nav-section">Gestión</div>
    <div class="nav-item" onclick="navigate('nuevo')"><span class="nav-icon">➕</span> Nuevo Permiso PT Altura</div>
    <div class="nav-item" onclick="navigate('contratistas')"><span class="nav-icon">🏢</span> Contratistas</div>
    <div class="nav-section">Reportes</div>
    <div class="nav-item" onclick="navigate('reportes')"><span class="nav-icon">📈</span> Reportes y Auditoría</div>
    <div class="nav-item"><span class="nav-icon">⚙️</span> Configuración</div>
  </nav>
  <div class="sidebar-user">
    <div class="user-info">
      <div class="user-avatar">JS</div>
      <div><div class="user-name">Juan Sepúlveda</div><div class="user-role">Emisor de Permiso · SSOMA</div></div>
    </div>
  </div>
</div>

<!-- MAIN -->
<div id="main">
  <div id="topbar">
    <div class="topbar-title" id="topbar-title">Dashboard</div>
    <div class="search-box"><span>🔍</span><input type="text" placeholder="Buscar permiso, área, contratista…"></div>
    <button class="notif-btn" onclick="showModal('notifModal')">🔔<span class="notif-dot"></span></button>
  </div>

  <div id="content">

    <!-- ====== DASHBOARD ====== -->
    <div class="screen active" id="screen-dashboard">
      <div class="alert-banner alert-warning">
        <span>⚠️</span><strong>2 permisos activos vencen en menos de 2 horas.</strong> Revisar y extender si corresponde.
        <span style="margin-left:auto;cursor:pointer;opacity:0.6" onclick="this.parentElement.remove()">✕</span>
      </div>
      <div class="kpi-grid">
        <div class="kpi-card green"><div class="kpi-icon">🟢</div><div class="kpi-num">8</div><div class="kpi-label">Permisos Activos Hoy</div><div class="kpi-trend up">↑ +2 vs ayer</div></div>
        <div class="kpi-card yellow"><div class="kpi-icon">⏳</div><div class="kpi-num">3</div><div class="kpi-label">Pendientes Aprobación</div><div class="kpi-trend down">⚠ Más de 30 min en cola</div></div>
        <div class="kpi-card red"><div class="kpi-icon">🔴</div><div class="kpi-num">1</div><div class="kpi-label">Vencidos Sin Cerrar</div><div class="kpi-trend down">Requiere acción inmediata</div></div>
        <div class="kpi-card blue"><div class="kpi-icon">✅</div><div class="kpi-num">24</div><div class="kpi-label">Completados Esta Semana</div><div class="kpi-trend up">↑ 92% cerrados a tiempo</div></div>
      </div>
      <div class="dash-grid">
        <div>
          <div class="card" style="margin-bottom:20px">
